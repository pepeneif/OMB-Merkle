diff --git a/src/state/thread-move.test.ts b/src/state/thread-move.test.ts
new file mode 100644
index 000000000..7fb3c7c18
--- /dev/null
+++ b/src/state/thread-move.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { serverMovedThread, threadStillKnown } from "./thread-move";
+
+const owner = (threadId: string, tasks: string[], switchingTo?: string) => ({
+  threadId, switchingTo, tasks: tasks.map((id) => ({ threadId: id })),
+});
+
+describe("the server moving a bot's active thread", () => {
+  it("knows the thread on screen is still one of the bot's threads", () => {
+    expect(threadStillKnown(owner("a", ["a", "b"]), owner("b", ["a", "b"]))).toBe(true);
+    expect(threadStillKnown(owner("a", ["a", "b"]), owner("b", ["b"]))).toBe(false);
+    expect(threadStillKnown(owner("a", ["a"]), owner("a", ["a"]))).toBe(true);
+    expect(threadStillKnown(undefined, owner("b", ["b"]))).toBe(false);
+  });
+
+  it("is a move nobody on this client asked for", () => {
+    expect(serverMovedThread(owner("a", ["a", "b"]), owner("b", ["a", "b"]))).toBe(true);
+    expect(serverMovedThread(owner("a", ["a", "b"]), owner("a", ["a", "b"]))).toBe(false);
+    expect(serverMovedThread(owner("a", ["a", "b"]), owner("b", ["b"]))).toBe(false);
+  });
+
+  it("is the person's own switch when the client is waiting for that thread", () => {
+    expect(serverMovedThread(owner("a", ["a", "b"], "b"), owner("b", ["a", "b"]))).toBe(false);
+  });
+
+  it("keeps the thread when a partial frame does not list it", () => {
+    // A frame that carries one thread alone says nothing about the others, so it cannot prove one is gone.
+    expect(threadStillKnown(owner("a", ["a"]), { threadId: "b" })).toBe(true);
+    expect(serverMovedThread(owner("a", ["a"]), { threadId: "b" })).toBe(true);
+  });
+});
diff --git a/src/state/thread-move.ts b/src/state/thread-move.ts
new file mode 100644
index 000000000..fd92d8328
--- /dev/null
+++ b/src/state/thread-move.ts
@@ -0,0 +1,25 @@
+// A bot's active thread lives on the server (`bot.threadId`), and the server moves it on its own: a routine's run
+// opening its own thread, a deleted thread handing over to the next one. The chat on screen never follows that by
+// itself; these decide when a snapshot may replace the thread the person is reading.
+
+interface Owner {
+  threadId: string;
+  switchingTo?: string;
+  tasks?: ReadonlyArray<{ threadId: string }>;
+}
+
+/** Whether the thread the person has open is still one of the owner's threads in the frame. */
+export function threadStillKnown(known: Owner | undefined, incoming: Owner): boolean {
+  if (!known?.threadId) return false;
+  if (known.threadId === incoming.threadId) return true;
+  if (!incoming.tasks) return true;
+  return incoming.tasks.some((task) => task.threadId === known.threadId);
+}
+
+/** A snapshot moves the owner to another thread while the one on screen still exists: the person asked for the switch
+ * (`switchingTo`) or it is not their turn to be moved. */
+export function serverMovedThread(known: Owner | undefined, incoming: Owner): boolean {
+  if (!known || !incoming.threadId || incoming.threadId === known.threadId) return false;
+  if (known.switchingTo === incoming.threadId) return false;
+  return threadStillKnown(known, incoming);
+}
