diff --git a/src/lib/remark-user-format.test.ts b/src/lib/remark-user-format.test.ts
new file mode 100644
index 000000000..4f5fd6e3c
--- /dev/null
+++ b/src/lib/remark-user-format.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vitest";
+import { userTextHasMarkdown } from "./remark-user-format";
+
+describe("the person's own text drawn as Markdown", () => {
+  it("takes a bare web address as formatted, so it is drawn as a link", () => {
+    for (const text of [
+      "mira https://data.merkle.space/reportes/versiones-omb.html",
+      "http://example.com/x?y=1",
+      "www.merkle.space",
+      "lee https://es.wikipedia.org/wiki/Monterrey.",
+    ]) expect(userTextHasMarkdown(text), text).toBe(true);
+  });
+
+  it("leaves ordinary prose alone", () => {
+    for (const text of ["hola", "el informe de ayer", "1,234.56 y 8.42%", "y/o", "cuesta 5 dolares"]) {
+      expect(userTextHasMarkdown(text), text).toBe(false);
+    }
+  });
+});
diff --git a/src/lib/remark-user-format.ts b/src/lib/remark-user-format.ts
index 454941049..9403c0c0b 100644
--- a/src/lib/remark-user-format.ts
+++ b/src/lib/remark-user-format.ts
@@ -42,8 +42,13 @@ export type { Message };
 
 /** A3: ¿el mensaje del usuario trae formato de markdown? Si no, se pinta como texto
  *  literal (conserva la direccion por linea via `.chat-text`); si si, se renderiza. */
+/** A web address written as-is ("https://…", "http://…", "www.…"): the person's own text becomes Markdown so the
+ *  address is drawn as a link, and the link opens in a new window. */
+const BARE_URL = /(?:https?:\/\/|www\.)[^\s<>()[\]`]+\.[^\s<>()[\]`]*/i;
+
 export function userTextHasMarkdown(text: string): boolean {
   if (text.includes("**") || text.includes("__") || text.includes("`") || text.includes("~~") || text.includes("++")) return true;
+  if (BARE_URL.test(text)) return true;
   if (/^\s*(?:[-*+]|\d{1,3}[.)])\s+\S/m.test(text)) return true;
   if (/^\s*#{1,6}\s+\S/m.test(text)) return true;
   if (/\]\([^)\s]+\)/.test(text)) return true;
