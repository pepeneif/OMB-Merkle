@@ -53,7 +66,8 @@ export function codexBackgroundRoute(catalog: ModelCatalog, smallModelsUsable: b
   const own = fallback?.model || accountDefault(catalog);
   const provider = own ? providerOf(own) : OFFICIAL_CODEX_PROVIDER;
   const small = smallModelsUsable && !(openaiUnreachable && provider === OFFICIAL_CODEX_PROVIDER);
-  const model = (small ? codexBackgroundModel(catalog, fallback?.refused, provider) : null) ?? own;
+  const pinned = pinnedBackgroundModel(catalog, process.env.OMB_BACKGROUND_MODEL, provider);
+  const model = pinned ?? (small ? codexBackgroundModel(catalog, fallback?.refused, provider) : null) ?? own;
   if (!model) return null;
   return own && own !== model ? { model, retry: own } : { model };
 }
diff --git a/server/model-kinds.ts b/server/model-kinds.ts
new file mode 100644
index 000000000..99530ee3a
--- /dev/null
+++ b/server/model-kinds.ts
@@ -0,0 +1,8 @@
+// A model that draws pictures is never a small text model: its name can carry a quick-looking word
+// (`gemini-nano-banana-2.1` has "nano"), so both the quick-turn and the background selectors skip it.
+const IMAGE_MODEL = /(?:^|[-_/. ])(?:image|images|imagegen|text-to-image|nano-banana\w*|dall-e\w*|dalle\w*|flux\w*|stable-diffusion\w*|sdxl\w*|imagen\w*|ideogram\w*|recraft\w*|seedream\w*|midjourney\w*)(?=$|[-_/. :])/i;
+
+/** True for an image-generation model id or label, in any provider's spelling. */
+export function isImageModel(name: string): boolean {
+  return IMAGE_MODEL.test(name);
+}
