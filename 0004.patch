+/* ────────────────────────────────────────────────────────────────────────
+   PERSONALIZACION MANAGER — ancho de burbujas ajustable (parche 0006)
+   Cada burbuja toma su max-width de una variable en :root. Sin mango tocado,
+   las variables no existen y manda el valor por defecto de aqui. El usuario
+   puede ensanchar/adelgazar arrastrando el mango del borde libre; doble clic
+   en el mango vuelve al valor por defecto (por dispositivo, localStorage).
+   ──────────────────────────────────────────────────────────────────────── */
+.bbl {
+  max-width: 90%;
+}
+.bbl-bot,
+.bbl-user {
+  max-width: min(var(--bubble-bot, 900px), 90%);
+}
+.bbl-user {
+  max-width: min(var(--bubble-user, 900px), 90%);
+}
+.bbl-run {
+  width: min(var(--bubble-run, 720px), 95%);
+  max-width: 95%;
+}
+
+/* Personalizacion Manager: alineacion vertical de la cabecera del chat. Jose
+   pidio menos espacio ARRIBA y mas ABAJO, para centrar los controles (nombre,
+   hilos, buscar, modelo...) en la barra, cuya mitad inferior es translucida
+   (el cristal se desvanece en los ultimos ~20px). El alto total de la barra
+   no cambia (6 + 31 + 18 = 55, igual que el py-3 original 12 + 31 + 12).
+   REVERSIBLE: pon ambos a 12px y queda exactamente como antes. */
+:root {
+  --chathead-pad-top: 6px;
+  --chathead-pad-bottom: 18px;
+}
+[data-chathead-pad] {
+  padding-top: var(--chathead-pad-top);
+  padding-bottom: var(--chathead-pad-bottom);
+}
+
+/* El mango solo existe en escritorio: en tactil no hay hover y chocaria con
+   el scroll y la seleccion de texto. */
+.bbl {
+  position: relative;
+}
+.bbl-handle {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 5px;
+  cursor: col-resize;
+  touch-action: none;
+  opacity: 0;
+  border-radius: 9999px;
+  transition: opacity 120ms ease, background-color 120ms ease;
+}
+.bbl-bot > .bbl-handle { right: -6px; }
+.bbl-user > .bbl-handle { left: -6px; }
+.bbl:hover > .bbl-handle,
+.bbl-handle:focus-visible {
+  opacity: 1;
+  background-color: color-mix(in srgb, var(--color-accent) 18%, transparent);
+}
+.bbl-run > .bbl-handle { left: -6px; }
+@media (hover: none) {
+  .bbl-handle { display: none; }
+}
